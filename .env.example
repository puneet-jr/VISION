# VisionShield AI - local configuration. Copy to .env and adjust.
# Paths are relative to the project root unless absolute.

# --- Server ---
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# --- Detection (Ultralytics YOLO, pretrained COCO weights) ---
YOLO_MODEL=yolo11n.pt
YOLO_DEVICE=
DETECTION_CONF=0.35
DETECTION_IOU=0.5
INFERENCE_IMGSZ=640

# --- Tracking ---
TRACKER_CONFIG=bytetrack.yaml

# --- Video input ---
CAMERA_INDEX=0
# RTSP / IP camera URL. Only settable here (never through the API).
STREAM_URL=
VIDEO_DIR=data/videos
LOOP_VIDEO=false
MAX_FRAME_WIDTH=960
MAX_FPS=15
RECONNECT_ATTEMPTS=3
RECONNECT_DELAY_S=2.0
MAX_VIDEO_UPLOAD_MB=500
MAX_IMAGE_UPLOAD_MB=10

# --- Database ---
DATABASE_PATH=data/visionshield.db

# --- Threat scoring (weights must sum to 1.0) ---
WEIGHT_OBJECT_RISK=0.30
WEIGHT_CONFIDENCE=0.15
WEIGHT_MOVEMENT=0.20
WEIGHT_PROXIMITY=0.20
WEIGHT_PERSISTENCE=0.15
# Speed (fraction of frame diagonal per second) that saturates the movement factor
SPEED_REF_DIAG_PER_S=0.15
# Distance (fraction of frame diagonal) at which zone proximity falls to 0
ZONE_NEAR_FRACTION=0.15
# Seconds inside a zone that saturate the persistence factor
DWELL_REF_S=10.0
ZONE_EXIT_GRACE_S=2.0
# Optional JSON override of per-class object risk (0..1), e.g. {"person":0.4,"knife":0.9}
# OBJECT_RISK={"person":0.4,"knife":0.9}

# --- Alerts ---
ALERT_COOLDOWN_S=10.0
ALERT_MIN_LEVEL=MEDIUM

# --- Zones (copy config/zones.example.json to config/zones.json to customise) ---
ZONES_FILE=config/zones.json
